# Only public build values. Never put credentials here.
VITE_API_BASE_URL=/api
# Enable only after confirming backend cookie/auth endpoints and host token flow.
VITE_MBANK_AUTH_ENABLED=false
# Explicit development-only preview; ignored by production. No payment/auth/close mock success.
VITE_ENABLE_MBANK_MOCK=false
# Comma-separated exact approved origins; default is the current origin. Native allowlist is configured separately.
VITE_MBANK_ALLOWED_ORIGINS=
